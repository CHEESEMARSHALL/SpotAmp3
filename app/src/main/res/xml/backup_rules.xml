<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Credentials are device-bound and must never be restored through backup. -->
    <exclude domain="sharedpref" path="plex_settings_secure.xml" />
    <exclude domain="sharedpref" path="plex_settings.xml" />
    <!-- Camera permission history is specific to this OS install and must not restore elsewhere. -->
    <exclude domain="sharedpref" path="companion_pairing_permissions.xml" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
