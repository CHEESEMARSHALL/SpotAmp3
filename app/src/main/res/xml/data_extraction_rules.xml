<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Backend credentials are device-bound and are intentionally excluded. -->
        <exclude domain="sharedpref" path="plex_settings_secure.xml" />
        <exclude domain="sharedpref" path="plex_settings.xml" />
        <!-- Camera permission history is specific to this OS install and must not restore elsewhere. -->
        <exclude domain="sharedpref" path="companion_pairing_permissions.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="plex_settings_secure.xml" />
        <exclude domain="sharedpref" path="plex_settings.xml" />
        <exclude domain="sharedpref" path="companion_pairing_permissions.xml" />
    </device-transfer>
</data-extraction-rules>
